{
  "name": "@jcodesmore/slack-for-ai-agents",
  "version": "0.1.1",
  "description": "Slack workspace admin tools for AI coding agents — natural-language management of channels, usergroups, Block Kit messages, scheduled posts, canvases, and full workspace templates",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "slack-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "scripts",
    "templates",
    ".claude-plugin",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "JCodesMore",
    "url": "https://github.com/JCodesMore"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JCodesMore/slack-for-ai-agents.git"
  },
  "homepage": "https://github.com/JCodesMore/slack-for-ai-agents",
  "bugs": {
    "url": "https://github.com/JCodesMore/slack-for-ai-agents/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "slack",
    "slack-bot",
    "ai-agents",
    "claude-code",
    "block-kit",
    "workspace-admin",
    "plugin"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@slack/web-api": "^7.10.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
